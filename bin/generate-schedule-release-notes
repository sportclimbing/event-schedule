#!/usr/bin/env php
<?php declare(strict_types=1);

use SportClimbing\EventDetails\Command\GenerateScheduleReleaseNotesCommand;
use Symfony\Component\Console\Application;

require __DIR__ . '/../vendor/autoload.php';

$application = new Application('World Climbing Schedule Release Notes Generator');
$application->addCommand(new GenerateScheduleReleaseNotesCommand());
$application->setDefaultCommand(GenerateScheduleReleaseNotesCommand::NAME, isSingleCommand: true);

exit($application->run());
